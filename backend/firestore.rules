rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user can access a document only when its user_id belongs to them.
    function ownsExistingDocument() {
      return request.auth != null
        && resource.data.user_id == request.auth.uid;
    }

    // Creates have no existing resource, so ownership is checked on the incoming data.
    function ownsNewDocument() {
      return request.auth != null
        && request.resource.data.user_id == request.auth.uid;
    }

    match /users/{uid} {
      // User profiles are private to their authenticated owner.
      allow read, update, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
    }
    match /patients/{patientId} {
      // Patient records are private to the user who owns them.
      allow read, update, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
    }
    match /journal_entries/{entryId} {
      // Journal entries and their media metadata are private to their owner.
      allow read, update, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
    }
    match /reminders/{reminderId} {
      // Reminders are private to the user who created them.
      allow read, update, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
    }
    match /user_scores/{scoreId} {
      // Cognitive scores are private to the user they describe.
      allow read, update, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
    }
    match /game_sessions/{sessionId} {
      // A user can access only their own game sessions.
      allow read, update, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
    }
    match /game_attempts/{attemptId} {
      // A user can access only their own game attempts.
      allow read, update, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
    }
    match /journal_stories/{storyId} {
      // Generated stories are private to their owner.
      allow read, update, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
    }
    match /{document=**} {
      // Any collection not listed above is denied by default.
      allow read, write: if false;
    }
  }
}
