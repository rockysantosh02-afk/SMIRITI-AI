rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function caregiverOf(patientId) {
      return signedIn() && get(/databases/$(database)/documents/patients/$(patientId)).data.caregiver_uid == request.auth.uid;
    }
    match /users/{uid} {
      allow read, update: if self(uid);
      allow create: if self(uid);
    }
    match /patients/{patientId} {
      allow read: if self(patientId) || caregiverOf(patientId);
      allow update: if self(patientId) || caregiverOf(patientId);
      allow create: if signedIn();
    }
    match /memory_persons/{documentId} {
      allow read, write: if signedIn();
    }
    match /memory_photos/{documentId} {
      allow read, write: if signedIn();
    }
    match /memory_events/{documentId} {
      allow read, write: if signedIn();
    }
    match /memory_stories/{documentId} {
      allow read, write: if signedIn();
    }
    match /reminders/{reminderId} {
      allow read, write: if signedIn();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
