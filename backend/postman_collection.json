{
  "info": {"name": "Smriti AI Backend", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://127.0.0.1:8000"}, {"key": "token", "value": ""}],
  "item": [
    {"name": "Health", "request": {"method": "GET", "url": "{{baseUrl}}/health"}},
    {"name": "Games", "request": {"method": "GET", "url": "{{baseUrl}}/games"}},
    {"name": "Firebase Login", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"id_token\": \"TOKEN\"}"}, "url": "{{baseUrl}}/auth/firebase-login"}},
    {"name": "My Profile", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": "{{baseUrl}}/auth/me"}},
    {"name": "Due Reminders", "request": {"method": "GET", "url": "{{baseUrl}}/reminders/check-due"}}
  ]
}
