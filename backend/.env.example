# ============================
# FIREBASE CONFIGURATION
# ============================
# Project ID from Firebase Console
FIREBASE_PROJECT_ID=

# Auth Domain (from Firebase Console > Project Settings > General > Your apps > Web app)
FIREBASE_AUTH_DOMAIN=

# Storage bucket
FIREBASE_STORAGE_BUCKET=
# Firebase Web API Key (from Firebase Console > Project Settings > General > Your apps > Web app)
FIREBASE_WEB_API_KEY=


# Firebase Messaging Sender ID (from Firebase Console > Project Settings > Cloud Messaging)
FIREBASE_MESSAGING_SENDER_ID=

# Firebase App ID (from Firebase Console > Project Settings > General > Your apps)
FIREBASE_APP_ID=

# Firebase Measurement ID (from Firebase Console > Project Settings > General > Your apps > Web app)
FIREBASE_MEASUREMENT_ID=

# Service Account Credentials (copy from Firebase Console > Project Settings > Service Accounts)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=smriti-ai
FIREBASE_PRIVATE_KEY_ID=key-id-here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\nxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@smriti-ai.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk%40smriti-ai.iam.gserviceaccount.com

